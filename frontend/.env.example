NEXT_PUBLIC_SITE_URL=https://www.artisanbarber.com

# Academy employee SSO (disabled until both applications are configured)
ACADEMY_SSO_ENABLED=false
ACADEMY_SSO_BASE_URL=https://academy.artisanbarber.com
ACADEMY_SSO_CLIENT_ID=artisan-employee-portal
ACADEMY_SSO_CLIENT_SECRET=replace-with-the-matching-academy-secret
ACADEMY_SSO_CALLBACK_URL=https://www.artisanbarber.com/api/auth/callback/academy
ARTISAN_SESSION_SECRET=replace-with-at-least-32-random-bytes
ARTISAN_SESSION_MAX_AGE_SECONDS=3600
